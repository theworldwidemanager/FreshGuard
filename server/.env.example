# =========================================================================
# FreshGuard Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file with secrets to Git.
# =========================================================================

# Server listening port (Cloud hosts like Render / Railway set PORT automatically)
PORT=5000

# MongoDB Atlas connection string (Obtained from MongoDB Atlas Cloud Dashboard)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/freshguard?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_ATLAS_USER:YOUR_ATLAS_PASSWORD@YOUR_CLUSTER.mongodb.net/freshguard?retryWrites=true&w=majority

# Allowed frontend Client URL for CORS & Socket.IO
# For local development: http://localhost:5173
# For production deployment: https://your-freshguard-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Secret API key required in 'X-Device-Key' header from ESP32
# Must match DEVICE_API_KEY in esp32/FreshGuard_ESP32_Cloud.ino
ESP32_API_KEY=freshguard_secret_device_key_change_me_in_production
